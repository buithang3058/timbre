ANTHROPIC_API_KEY=
SEMRUSH_API_KEY=

# Bing Webmaster Tools: each project is a separate BWT account, so one key
# per project (BWT > Settings > API access). Fallback BING_API_KEY optional.
BING_API_KEY_TOKEMIST=
BING_API_KEY_SIMPLIZE=
BING_API_KEY_MOTQUACAM=

# Per-project GSC credentials live in projects/[project]/config.env
# GSC_SITE_URL and GSC_KEY_PATH are set there, not here
# Bing site URL is per-project too: BING_SITE_URL in projects/[project]/config.env
